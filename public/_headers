# Cloudflare Pages – HTTP headers (copied to dist/_headers by Vite).
# Hashed build assets: cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts (stable names, regenerated by npm run font:subset): a day, then revalidate.
/fonts/*
  Cache-Control: public, max-age=86400, must-revalidate

# Entry point and service worker: always revalidate, so a deploy is picked up at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
